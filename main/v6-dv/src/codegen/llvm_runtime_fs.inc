// ==========================================
// Lors Compiler v6 - Runtime FS & String Transform Helpers
// ==========================================

algorithm cg_emit_fs_and_str_helpers() -> void
begin
    cg_emit_line("; --- Helper: __lors_reverse ---");
    cg_emit_line("define linkonce_odr ptr @__lors_reverse(ptr %s) {");
    cg_emit_line("  %len = call i64 @strlen(ptr %s)");
    cg_emit_line("  %total = add i64 %len, 1");
    cg_emit_line("  %buf = call ptr @malloc(i64 %total)");
    cg_emit_line("  %i_ptr = alloca i64");
    cg_emit_line("  store i64 0, ptr %i_ptr");
    cg_emit_line("  br label %rev_loop");
    cg_emit_line("rev_loop:");
    cg_emit_line("  %i = load i64, ptr %i_ptr");
    cg_emit_line("  %cmp = icmp slt i64 %i, %len");
    cg_emit_line("  br i1 %cmp, label %rev_body, label %rev_end");
    cg_emit_line("rev_body:");
    cg_emit_line("  %src_idx = sub i64 %len, 1");
    cg_emit_line("  %src_idx2 = sub i64 %src_idx, %i");
    cg_emit_line("  %src_elem = getelementptr i8, ptr %s, i64 %src_idx2");
    cg_emit_line("  %ch = load i8, ptr %src_elem");
    cg_emit_line("  %dst_elem = getelementptr i8, ptr %buf, i64 %i");
    cg_emit_line("  store i8 %ch, ptr %dst_elem");
    cg_emit_line("  %next_i = add i64 %i, 1");
    cg_emit_line("  store i64 %next_i, ptr %i_ptr");
    cg_emit_line("  br label %rev_loop");
    cg_emit_line("rev_end:");
    cg_emit_line("  %null_ptr = getelementptr i8, ptr %buf, i64 %len");
    cg_emit_line("  store i8 0, ptr %null_ptr");
    cg_emit_line("  ret ptr %buf");
    cg_emit_line("}");
    cg_emit_line("");

    cg_emit_line("; --- Helper: __lors_to_upper ---");
    cg_emit_line("define linkonce_odr ptr @__lors_to_upper(ptr %s) {");
    cg_emit_line("  %len = call i64 @strlen(ptr %s)");
    cg_emit_line("  %buf = call ptr @strdup(ptr %s)");
    cg_emit_line("  %i_ptr = alloca i64");
    cg_emit_line("  store i64 0, ptr %i_ptr");
    cg_emit_line("  br label %up_loop");
    cg_emit_line("up_loop:");
    cg_emit_line("  %i = load i64, ptr %i_ptr");
    cg_emit_line("  %cmp = icmp slt i64 %i, %len");
    cg_emit_line("  br i1 %cmp, label %up_body, label %up_end");
    cg_emit_line("up_body:");
    cg_emit_line("  %elem = getelementptr i8, ptr %buf, i64 %i");
    cg_emit_line("  %c = load i8, ptr %elem");
    cg_emit_line("  %is_lower_a = icmp sge i8 %c, 97");
    cg_emit_line("  %is_lower_z = icmp sle i8 %c, 122");
    cg_emit_line("  %is_lower = and i1 %is_lower_a, %is_lower_z");
    cg_emit_line("  br i1 %is_lower, label %to_up, label %up_next");
    cg_emit_line("to_up:");
    cg_emit_line("  %conv = sub i8 %c, 32");
    cg_emit_line("  store i8 %conv, ptr %elem");
    cg_emit_line("  br label %up_next");
    cg_emit_line("up_next:");
    cg_emit_line("  %next_i = add i64 %i, 1");
    cg_emit_line("  store i64 %next_i, ptr %i_ptr");
    cg_emit_line("  br label %up_loop");
    cg_emit_line("up_end:");
    cg_emit_line("  ret ptr %buf");
    cg_emit_line("}");
    cg_emit_line("");

    cg_emit_line("; --- Helper: __lors_to_lower ---");
    cg_emit_line("define linkonce_odr ptr @__lors_to_lower(ptr %s) {");
    cg_emit_line("  %len = call i64 @strlen(ptr %s)");
    cg_emit_line("  %buf = call ptr @strdup(ptr %s)");
    cg_emit_line("  %i_ptr = alloca i64");
    cg_emit_line("  store i64 0, ptr %i_ptr");
    cg_emit_line("  br label %low_loop");
    cg_emit_line("low_loop:");
    cg_emit_line("  %i = load i64, ptr %i_ptr");
    cg_emit_line("  %cmp = icmp slt i64 %i, %len");
    cg_emit_line("  br i1 %cmp, label %low_body, label %low_end");
    cg_emit_line("low_body:");
    cg_emit_line("  %elem = getelementptr i8, ptr %buf, i64 %i");
    cg_emit_line("  %c = load i8, ptr %elem");
    cg_emit_line("  %is_upper_A = icmp sge i8 %c, 65");
    cg_emit_line("  %is_upper_Z = icmp sle i8 %c, 90");
    cg_emit_line("  %is_upper = and i1 %is_upper_A, %is_upper_Z");
    cg_emit_line("  br i1 %is_upper, label %to_low, label %low_next");
    cg_emit_line("to_low:");
    cg_emit_line("  %conv = add i8 %c, 32");
    cg_emit_line("  store i8 %conv, ptr %elem");
    cg_emit_line("  br label %low_next");
    cg_emit_line("low_next:");
    cg_emit_line("  %next_i = add i64 %i, 1");
    cg_emit_line("  store i64 %next_i, ptr %i_ptr");
    cg_emit_line("  br label %low_loop");
    cg_emit_line("low_end:");
    cg_emit_line("  ret ptr %buf");
    cg_emit_line("}");
    cg_emit_line("");

    cg_emit_line("; --- Helper: __lors_file_read ---");
    cg_emit_line("define linkonce_odr ptr @__lors_file_read(ptr %path) {");
    cg_emit_line("  %f = call ptr @fopen(ptr %path, ptr @.str_mode_r)");
    cg_emit_line("  %is_null = icmp eq ptr %f, null");
    cg_emit_line("  br i1 %is_null, label %fr_empty, label %fr_read");
    cg_emit_line("fr_empty:");
    cg_emit_line("  %empty_buf = call ptr @malloc(i64 1)");
    cg_emit_line("  store i8 0, ptr %empty_buf");
    cg_emit_line("  ret ptr %empty_buf");
    cg_emit_line("fr_read:");
    cg_emit_line("  call i32 @fseek(ptr %f, i64 0, i32 2)");
    cg_emit_line("  %size = call i64 @ftell(ptr %f)");
    cg_emit_line("  call i32 @fseek(ptr %f, i64 0, i32 0)");
    cg_emit_line("  %buf_size = add i64 %size, 1");
    cg_emit_line("  %buf = call ptr @malloc(i64 %buf_size)");
    cg_emit_line("  call i64 @fread(ptr %buf, i64 1, i64 %size, ptr %f)");
    cg_emit_line("  %end_ptr = getelementptr i8, ptr %buf, i64 %size");
    cg_emit_line("  store i8 0, ptr %end_ptr");
    cg_emit_line("  call i32 @fclose(ptr %f)");
    cg_emit_line("  ret ptr %buf");
    cg_emit_line("}");
    cg_emit_line("");

    cg_emit_line("; --- Helper: __lors_file_write ---");
    cg_emit_line("define linkonce_odr void @__lors_file_write(ptr %path, ptr %content) {");
    cg_emit_line("  %f = call ptr @fopen(ptr %path, ptr @.str_mode_w)");
    cg_emit_line("  %is_null = icmp eq ptr %f, null");
    cg_emit_line("  br i1 %is_null, label %fw_end, label %fw_do");
    cg_emit_line("fw_do:");
    cg_emit_line("  %len = call i64 @strlen(ptr %content)");
    cg_emit_line("  call i64 @fwrite(ptr %content, i64 1, i64 %len, ptr %f)");
    cg_emit_line("  call i32 @fclose(ptr %f)");
    cg_emit_line("  br label %fw_end");
    cg_emit_line("fw_end:");
    cg_emit_line("  ret void");
    cg_emit_line("}");
    cg_emit_line("");
end
